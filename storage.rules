rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid}/invitations/{invitationId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin()) && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
